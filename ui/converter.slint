// The converter (WR-07): an inline card inside the popup, opened from the header. One selector
// picks the mode: BS to AD, AD to BS, or the days between two BS dates. Every row is a label
// column and a field column, and the result has a box of its own. `app::converter` does the work;
// `ui_bridge::set_converter` fills `data`.

import { FocusFrame } from "focus-frame.slint";
import { Segmented } from "controls.slint";
import { Theme } from "theme.slint";
import { Button, LineEdit } from "std-widgets.slint";

export struct ConverterData {
    short: string,
    long: string,
    error: string,
}

/// The card's padding, and the label column every row shares (widget-design §7a).
global ConverterLayout {
    out property <length> padding: 12px;
    out property <length> label-width: 72px;
    out property <length> gap: 8px;
}

/// A label on the left and a field on the right, both columns the same in every row.
component ConverterRow inherits HorizontalLayout {
    in property <string> text;
    in property <bool> top-aligned: false;
    spacing: ConverterLayout.gap;
    Text {
        width: ConverterLayout.label-width;
        text: root.text;
        color: Theme.ink-muted;
        font-size: 13px;
        vertical-alignment: root.top-aligned ? top : center;
        overflow: elide;
        accessible-role: none;
    }
    @children
}

export component Converter inherits Rectangle {
    in-out property <ConverterData> data;
    in-out property <string> input: "";
    in-out property <string> from: "";
    in-out property <string> to: "";
    /// 0 = Convert, 1 = Days.
    in-out property <int> tab: 0;
    /// 0 = BS to AD, 1 = AD to BS.
    in-out property <int> direction: 0;

    callback edited(string, int);
    callback days-edited(string, string);
    callback closed();
    callback control-focused(string);

    /// The focused control's stable name.
    out property <string> focused-control: root.active-control;
    /// Set by the control that gains focus inside the converter.
    in-out property <string> active-control: "";
    changed active-control => { root.control-focused(root.active-control); }

    /// The selector's position: BS to AD, AD to BS, then Days.
    property <int> mode: root.tab == 1 ? 2 : root.direction;

    width: 320px;
    height: 264px;
    background: Theme.surface-raised;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.hairline;

    // Swallow clicks on the card so they do not reach the scrim behind it.
    TouchArea {}

    VerticalLayout {
        padding: ConverterLayout.padding;
        spacing: ConverterLayout.gap;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Converter");
                color: Theme.ink;
                font-size: 16px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            FocusFrame {
                width: close-button.width;
                height: close-button.height;
                focused: close-button.has-focus;
                close-button := Button {
                    text: @tr("Close");
                    accessible-label: @tr("Close converter");
                    clicked => { root.closed(); }
                    changed has-focus => {
                        if (close-button.has-focus) { root.active-control = "converter close"; }
                    }
                }
            }
        }

        Segmented {
            label: @tr("Conversion");
            options: [@tr("BS → AD"), @tr("AD → BS"), @tr("Days")];
            segment-width: (root.width - 2 * ConverterLayout.padding) / 3;
            selected: root.mode;
            picked(index) => {
                if (index == 2) {
                    root.tab = 1;
                    root.days-edited(root.from, root.to);
                } else {
                    root.tab = 0;
                    root.direction = index;
                    root.edited(root.input, index);
                }
            }
            focused => { root.active-control = "converter mode"; }
        }

        if root.tab == 0: ConverterRow {
            text: root.direction == 0 ? @tr("BS date") : @tr("AD date");
            FocusFrame {
                horizontal-stretch: 1;
                height: input.height;
                focused: input.has-focus;
                input := LineEdit {
                    width: 100%;
                    text <=> root.input;
                    placeholder-text: root.direction == 0 ? "2081/01/01" : "2024-04-13";
                    accessible-label: @tr("Date to convert");
                    edited(text) => { root.edited(text, root.direction); }
                    changed has-focus => {
                        if (input.has-focus) { root.active-control = "converter input"; }
                    }
                }
            }
        }

        if root.tab == 1: ConverterRow {
            text: @tr("From");
            FocusFrame {
                horizontal-stretch: 1;
                height: from-input.height;
                focused: from-input.has-focus;
                from-input := LineEdit {
                    width: 100%;
                    text <=> root.from;
                    placeholder-text: "2081/01/01";
                    accessible-label: @tr("From BS date");
                    edited(text) => { root.days-edited(text, root.to); }
                    changed has-focus => {
                        if (from-input.has-focus) { root.active-control = "converter from"; }
                    }
                }
            }
        }
        if root.tab == 1: ConverterRow {
            text: @tr("To");
            FocusFrame {
                horizontal-stretch: 1;
                height: to-input.height;
                focused: to-input.has-focus;
                to-input := LineEdit {
                    width: 100%;
                    text <=> root.to;
                    placeholder-text: "2081/01/01";
                    accessible-label: @tr("To BS date");
                    edited(text) => { root.days-edited(root.from, text); }
                    changed has-focus => {
                        if (to-input.has-focus) { root.active-control = "converter to"; }
                    }
                }
            }
        }

        ConverterRow {
            vertical-stretch: 1;
            top-aligned: true;
            text: @tr("Result");
            result := Rectangle {
                horizontal-stretch: 1;
                min-height: 64px;
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.hairline;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: start;
                    // An error is plain `ink`: red stays for today and holidays.
                    if root.data.error != "": Text {
                        text: root.data.error;
                        color: Theme.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.data.error == "" && root.data.short != "": Text {
                        text: root.data.short;
                        color: Theme.ink;
                        font-size: 16px;
                    }
                    if root.data.error == "" && root.data.long != "": Text {
                        text: root.data.long;
                        color: Theme.ink-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
